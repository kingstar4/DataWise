{
  "expo": {
    "name": "DataWise",
    "slug": "DataWise",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/datawise-icon-v2.png",
    "scheme": "datawise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app-icon.icon",
      "bundleIdentifier": "com.thehubx.DataWise"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/images/datawise-android-foreground-v2.png",
        "monochromeImage": "./assets/images/datawise-android-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thehubx.DataWise",
      "versionCode": 3,
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.QUERY_ALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/datawise-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/images/datawise-splash-logo-v2.png",
          "imageWidth": 240,
          "android": {
            "image": "./assets/images/datawise-splash-logo-v2.png",
            "imageWidth": 240
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8207a701-d333-4625-81a3-1fef609b86cb"
      }
    }
  }
}
